{:paths ["src" "resources"]
 :deps {com.layerware/hugsql {:mvn/version "0.5.3"}
        org.postgresql/postgresql {:mvn/version "42.7.14"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}}
 :aliases
  {;;
  ;; $ clj -X:test  # Run the test suite on every supported PostgreSQL version,
  ;;                # then run code coverage once on the latest version.
  ;;                # Override versions with e.g. clj -X:test :postgres-versions '["16.15.0"]'
  ;;
  :test {:exec-fn     postgres-extras-clj.test-runner/run
         :extra-paths ["test"]
         :exec-args   {}}

  ;;
  ;; Per-version suite runner. The Zonky binaries artifact (which pins the
  ;; PostgreSQL version) is injected by test-runner/run via -Sdeps.
  ;;
  :test-run {:extra-deps {com.layerware/hugsql-adapter-next-jdbc {:mvn/version "0.5.3"}
                          com.fzakaria/slf4j-timbre {:mvn/version "0.4.1"}
                          io.zonky.test/embedded-postgres {:mvn/version "2.2.2"}
                          lambdaisland/kaocha           {:mvn/version "1.91.1392"}
                          seancorfield/next.jdbc {:mvn/version "1.2.659"}}
             :exec-fn     kaocha.runner/exec-fn
             :extra-paths ["test"]
             :exec-args   {}}

  ;;
  ;; Code coverage on a single (latest) PostgreSQL version.
  ;;
  :coverage {:extra-deps {com.layerware/hugsql-adapter-next-jdbc {:mvn/version "0.5.3"}
                          com.fzakaria/slf4j-timbre {:mvn/version "0.4.1"}
                          io.zonky.test/embedded-postgres {:mvn/version "2.2.2"}
                          lambdaisland/kaocha           {:mvn/version "1.91.1392"}
                          lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}
                          seancorfield/next.jdbc {:mvn/version "1.2.659"}}
             :main-opts    ["-m" "kaocha.runner"]
             :extra-paths ["test"]}
  ;;
  ;; $ clj -M:dev  # NREPL and interactive terminal REPL in one
  :dev {:extra-paths ["test" "examples"]
        :extra-deps {cider/cider-nrepl {:mvn/version "0.63.1"}
                     com.fzakaria/slf4j-timbre {:mvn/version "0.4.1"}
                     org.scicloj/clay {:mvn/version "2.0.24"}
                     io.zonky.test/embedded-postgres {:mvn/version "2.2.2"}
                     io.zonky.test.postgres/embedded-postgres-binaries-linux-amd64 {:mvn/version "18.6.0"}
                     com.layerware/hugsql-adapter-next-jdbc {:mvn/version "0.5.3"}
                     seancorfield/next.jdbc {:mvn/version "1.2.659"}}
        :main-opts ["-m" "nrepl.cmdline"
                    "--middleware" "[cider.nrepl/cider-middleware]"
                    "--interactive"]}
  ;;
  ;; $ clj -M:notebook --render --base-target-path target/clay \
  ;;       --config-map '{:format [:quarto :html]}' examples/pgbench_tutorial.clj
  ;;   Render the pgbench example notebook with Clay (headless, no nREPL).
  ;;   The notebook queries a live PostgreSQL at localhost:5432 (see bb db:up).
  ;;
  :notebook {:extra-paths ["examples"]
             :extra-deps {com.fzakaria/slf4j-timbre {:mvn/version "0.4.1"}
                          org.scicloj/clay {:mvn/version "2.0.24"}
                          com.layerware/hugsql-adapter-next-jdbc {:mvn/version "0.5.3"}
                          seancorfield/next.jdbc {:mvn/version "1.2.659"}}
             :main-opts ["-m" "scicloj.clay.v2.main"]}
  ;;
  ;; $ clj -T:build jar     # Build target/com.github.perrygeo/postgres-extras-clj-{version}.jar
  ;; $ clj -T:build deploy  # Deploy to Clojars
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.3" :git/sha "15ead66"}
                 slipset/deps-deploy           {:mvn/version "0.2.0"}}
          :ns-default build}}}
